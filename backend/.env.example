# ─────────────────────────────────────────────────────────────
# SAPMS — Backend Environment
# Copy to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/capstone_db?schema=public"

# ── JWT ─────────────────────────────────────────────────────
# Use long random strings in production, e.g. `openssl rand -hex 48`
JWT_ACCESS_SECRET="sapms-access-secret-change-in-production"
JWT_REFRESH_SECRET="sapms-refresh-secret-change-in-production"
JWT_ACCESS_EXPIRES="8h"
JWT_REFRESH_EXPIRES="7d"

# ── Server ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# CORS — comma-separated list of allowed client origins
CLIENT_ORIGIN="http://localhost:5173"

# Used to build activation links emailed to imported students
APP_BASE_URL="http://localhost:5173"

# ── SMTP (optional) ─────────────────────────────────────────
# If unset, emails are logged to the server console instead of sent.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="SAPMS <no-reply@sapms.edu>"

# ── Cloudinary (optional) ───────────────────────────────────
# If unset, uploads fall back to local disk under backend/uploads.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Uploads ─────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50

# ── Rate limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=20
